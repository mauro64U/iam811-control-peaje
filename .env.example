# ============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - SISTEMA DE CONTROL DE PEAJE (IAM-811)
# Copiar este archivo como .env y completar con valores reales en producción.
# NUNCA subir el archivo .env al repositorio Git.
# ============================================================================

# --- 1. BASE DE DATOS (PostgreSQL en la nube: Neon / Supabase / Render) ---
DATABASE_URL=postgresql://usuario:password@ep-ejemplo-cloud.aws.neon.tech/peaje_db?sslmode=require

# --- 2. AUTENTICACIÓN GOOGLE OAUTH 2.0 Y SESIÓN JWT ---
GOOGLE_CLIENT_ID=tu-google-client-id-web.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=tu-google-client-id-android.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret
JWT_SECRET_KEY=cambiar_por_una_clave_secreta_aleatoria_de_64_caracteres_minimo
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- 3. LISTA BLANCA INICIAL DE ADMINISTRADORES (Separados por coma) ---
ADMIN_EMAILS=doc.alvaro.pinto.ma@unifranz.edu.bo,lpze.mauriciosebastian.vasquez.gu@unifranz.edu.bo

# --- 4. ENDPOINT DE INFERENCIA EN LA NUBE (Google Colab via Cloudflare Tunnel / Ngrok) ---
# Nota: También es actualizable en caliente desde la pestaña "Estado" del panel web (Rol Admin).
INFERENCE_URL=https://tu-tunel-activo.trycloudflare.com
INFERENCE_API_TOKEN=token_secreto_colab_inferencia

# --- 5. AGENTE CONVERSACIONAL (Google Gemini API) ---
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
GEMINI_MODEL=gemini-2.5-flash

# --- 6. TIEMPO REAL (SSE nativo + Soporte opcional Pusher para hosting compartido) ---
REALTIME_MODE=sse
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=us2

# --- 7. URL PÚBLICA DEL SUBDOMINIO HTTPS (Para CORS, Web y App Móvil) ---
PUBLIC_WEB_URL=https://peaje.tudominio.com
VITE_API_BASE_URL=https://peaje.tudominio.com/api/v1
VITE_GOOGLE_CLIENT_ID=tu-google-client-id-web.apps.googleusercontent.com

# --- 8. ROBOFLOW (Para descarga de datasets en notebooks de Google Colab) ---
ROBOFLOW_API_KEY=tu_roboflow_api_key
ROBOFLOW_WORKSPACE=tu_workspace
ROBOFLOW_PROJECT_M2=vehiculos-peaje-seg
ROBOFLOW_PROJECT_M3=ruedas-ejes-pose
